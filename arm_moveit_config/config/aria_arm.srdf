<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA SRDF — Semantic Robot Description
     Planning groups, end effector, named poses, collision matrix.
     ═══════════════════════════════════════════════════════════════ -->
<robot name="aria_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══ Planning Groups ═══════════════════════════════════════ -->
  <!-- Main arm chain: 5 revolute joints -->
  <group name="aria_arm">
    <chain base_link="base_link" tip_link="tool_frame"/>
  </group>

  <!-- Gripper group: single joint (mimic is handled in URDF) -->
  <group name="gripper">
    <joint name="gripper_joint"/>
  </group>

  <!-- ═══ End Effector ══════════════════════════════════════════ -->
  <end_effector name="aria_gripper"
                parent_link="gripper_holder_link"
                group="gripper"
                parent_group="aria_arm"/>

  <!-- ═══ Virtual Joint ═════════════════════════════════════════ -->
  <!-- Fixed joint from world to base_link (arm bolted to table) -->
  <virtual_joint name="world_joint"
                 type="fixed"
                 parent_frame="world"
                 child_link="base_link"/>

  <!-- ═══ Named Poses (mirror Stage 1 manual_control_node) ═════ -->
  <!-- Home: centered, arm upright -->
  <group_state name="home" group="aria_arm">
    <joint name="waist_joint"        value="0.0"/>
    <joint name="shoulder_joint"     value="1.5708"/>
    <joint name="elbow_joint"        value="1.3090"/>
    <joint name="wrist_pitch_joint"  value="0.0"/>
    <joint name="wrist_roll_joint"   value="0.0"/>
  </group_state>
  <group_state name="home" group="gripper">
    <joint name="gripper_joint" value="0.3491"/>
  </group_state>

  <!-- Ready: arm forward, ready to reach workspace -->
  <group_state name="ready" group="aria_arm">
    <joint name="waist_joint"        value="0.0"/>
    <joint name="shoulder_joint"     value="0.7854"/>
    <joint name="elbow_joint"        value="2.3562"/>
    <joint name="wrist_pitch_joint"  value="0.0"/>
    <joint name="wrist_roll_joint"   value="0.0"/>
  </group_state>
  <group_state name="ready" group="gripper">
    <joint name="gripper_joint" value="0.3491"/>
  </group_state>

  <!-- Folded: arm compact, close to body -->
  <group_state name="folded" group="aria_arm">
    <joint name="waist_joint"        value="0.0"/>
    <joint name="shoulder_joint"     value="2.7925"/>
    <joint name="elbow_joint"        value="0.3491"/>
    <joint name="wrist_pitch_joint"  value="0.0"/>
    <joint name="wrist_roll_joint"   value="0.0"/>
  </group_state>
  <group_state name="folded" group="gripper">
    <joint name="gripper_joint" value="0.1745"/>
  </group_state>

  <!-- Inspect: tilted wrist for camera view -->
  <group_state name="inspect" group="aria_arm">
    <joint name="waist_joint"        value="0.0"/>
    <joint name="shoulder_joint"     value="1.0472"/>
    <joint name="elbow_joint"        value="2.0944"/>
    <joint name="wrist_pitch_joint"  value="-0.5236"/>
    <joint name="wrist_roll_joint"   value="0.0"/>
  </group_state>
  <group_state name="inspect" group="gripper">
    <joint name="gripper_joint" value="0.3491"/>
  </group_state>

  <!-- ═══ Disable Collision Pairs ═══════════════════════════════ -->
  <!-- Adjacent links: always in contact by design -->
  <disable_collisions link1="base_link" link2="waist_link" reason="Adjacent"/>
  <disable_collisions link1="waist_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_holder_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_holder_link" link2="gear_housing_link" reason="Adjacent"/>
  <disable_collisions link1="gear_housing_link" link2="finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="gear_housing_link" link2="finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="finger_left_link" link2="finger_right_link" reason="Adjacent"/>

  <!-- Non-adjacent but cannot collide due to geometry -->
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="waist_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="top_camera_link" reason="Never"/>

</robot>
