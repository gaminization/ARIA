# GDB helper commands loaded by move_group when launched with debug:=true
# (see moveit_configs_utils.launches.generate_move_group_launch).
# These set up a human-readable backtrace and pretty printers.
set print pretty on
set print object on
set print static-members on
set print vtbl on
set print demangle on
set demangle-style gnu-v3
set print sevenbit-strings off
