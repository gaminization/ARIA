      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       FINGER MIMIC JOINT — Right Finger (Blue, Mirrored)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="finger_mimic_joint" type="revolute">
    <origin rpy="-1.25673 -1.55752 -1.57079" xyz="-0.02492 0.03048 0.00564"/>
    <parent link="wrist_link"/>
    <child link="finger_right_1_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="10.0" lower="0.0" upper="1.047" velocity="6.0"/>
    <mimic joint="gripper_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.02" friction="0.005"/>
  </joint>
  <link name="finger_right_1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <mass value="0.03"/>
      <inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.000015" iyz="0" izz="0.000015"/>
    </inertial>
    <visual name="Gripper2_Visual">
      <origin rpy="1.25673 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Gripper2.stl" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="blue"/>
