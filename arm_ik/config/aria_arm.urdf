<!-- ═══════════════════════════════════════════════════════════════
     ARIA Robot Arm — URDF / Xacro Model
     5-DOF Articulated Robotic Arm + 1-DOF Parallel Gripper
     Actuator Limits: MG995 / MM995 (Waist, Shoulder, Elbow), SG90 (Wrist, Gripper)
     Sensors: Wrist Camera (ESP32-CAM), MPU6050 6-Axis IMU
     ═══════════════════════════════════════════════════════════════ -->
<robot name="aria_arm">
  <!-- ═══════════════════════════════════════════════════════════
       gazebo_ros2_control PLUGIN — bridges Gazebo Classic ↔ ros2_control
       Uses GazeboSystem for Gazebo Classic 11
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/home/gaminizer/Projects/ARIA/install/arm_control/share/arm_control/config/aria_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       ARIA INDUSTRIAL GRIPPER PLUGIN — High-Fidelity Grasp & Release
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libaria_gripper_plugin.so" name="aria_gripper_plugin">
      <ros>
        <namespace>/aria</namespace>
      </ros>
      <palm_link>wrist_link</palm_link>
      <max_attach_dist>0.14</max_attach_dist>
    </plugin>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       ROBUST JOINT DYNAMICS (Implicit Spring-Damper in ODE)
       Prevents joint constraint explosion and shearing forces
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="waist_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="shoulder_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="elbow_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="wrist_pitch_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="gripper_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="finger_mimic_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       MATERIAL COLORS — Gazebo Classic specific
       ═══════════════════════════════════════════════════════════ -->
  <!-- Base: white -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Waist bracket: orange -->
  <gazebo reference="waist_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Upper arm: orange -->
  <gazebo reference="upper_arm_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Forearm: orange -->
  <gazebo reference="forearm_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Wrist: orange -->
  <gazebo reference="wrist_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Gripper holder: white -->
  <gazebo reference="gripper_holder_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Gear housing: white -->
  <gazebo reference="gear_housing_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>
  <!-- Left finger pair: blue -->
  <gazebo reference="finger_left_1_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>200000.0</kp>
    <kd>20.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <torsional>
      <ode>
        <coefficient>10.0</coefficient>
        <patch_radius>0.015</patch_radius>
      </ode>
    </torsional>
    <bounce>
      <restitution_coefficient>0.0</restitution_coefficient>
      <threshold>1000000.0</threshold>
    </bounce>
  </gazebo>
  <!-- Right finger pair: blue -->
  <gazebo reference="finger_right_1_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>200000.0</kp>
    <kd>20.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <torsional>
      <ode>
        <coefficient>10.0</coefficient>
        <patch_radius>0.015</patch_radius>
      </ode>
    </torsional>
    <bounce>
      <restitution_coefficient>0.0</restitution_coefficient>
      <threshold>1000000.0</threshold>
    </bounce>
  </gazebo>
  <!-- Cameras: dark gray -->
  <gazebo reference="top_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <!-- Preserve sensor joints from being lumped into parent link -->
  <gazebo reference="wrist_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       WRIST CAMERA SENSOR — ESP32-CAM (attached to wrist_link)
       640×480, 66° HFOV, 15fps
       Uses libgazebo_ros_camera.so for Gazebo Classic
       CLEAN: noise stddev = 0
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="wrist_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <pose>0.025 0.050 -0.007 1.5708 0.0000 2.3358</pose>
      <camera>
        <horizontal_fov>1.75</horizontal_fov>
        <!-- 100 degrees wide-angle lens -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
          <!-- CLEAN: no noise in Stage 1 -->
        </noise>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="wrist_camera_controller">
        <ros>
          <remapping>~/image_raw:=/wrist_camera/image_raw</remapping>
          <remapping>~/camera_info:=/wrist_camera/camera_info</remapping>
        </ros>
        <camera_name>wrist_camera</camera_name>
        <frame_name>wrist_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       IMU SENSOR — MPU6050 (on wrist_link)
       6-axis: 3-axis gyro + 3-axis accelerometer
       100 Hz update rate
       Uses libgazebo_ros_imu_sensor.so for Gazebo Classic
       CLEAN: all noise set to zero
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="mpu6050_sim" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_controller">
        <ros>
          <remapping>~/out:=/mpu6050/imu_raw</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       CONTACT SENSORS — on gripper fingers
       Detect objects grasped between finger pairs
       Uses libgazebo_ros_bumper.so for Gazebo Classic
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="finger_left_1_link">
    <sensor name="gripper_contact_left" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_left_1_link_fixed_joint_lump__finger_left_1_link_collision_1</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="contact_left_controller">
        <ros>
          <remapping>~/out:=/gripper/contact_left</remapping>
        </ros>
        <frame_name>finger_left_1_link</frame_name>
      </plugin>
    </sensor>
    <!-- Finger surface friction -->
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <gazebo reference="finger_right_1_link">
    <sensor name="gripper_contact_right" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_right_1_link_fixed_joint_lump__finger_right_1_link_collision_1</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="contact_right_controller">
        <ros>
          <remapping>~/out:=/gripper/contact_right</remapping>
        </ros>
        <frame_name>finger_right_1_link</frame_name>
      </plugin>
    </sensor>
    <!-- Finger surface friction -->
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT FRICTION — realistic but not overdone for Stage 1
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="waist_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="shoulder_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="elbow_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_pitch_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_roll_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="gripper_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <!-- 60 deg open -->
  <!-- ═══════════════════════════════════════════════════════════
       MATERIALS (for RViz visualization)
       ═══════════════════════════════════════════════════════════ -->
  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.55 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.15 0.35 0.85 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <!-- ═══════════════════════════════════════════════════════════
       WORLD ANCHOR & FIXED TABLE ATTACHMENT
       ═══════════════════════════════════════════════════════════ -->
  <link name="world"/>
  <joint name="fixed_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 1.5708" xyz="0.0 0.0 0.614"/>
  </joint>
  <!-- ═══════════════════════════════════════════════════════════
       LINK 1: BASE — White cylindrical base housing
       ═══════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <mass value="0.30"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
    </inertial>
    <visual name="Base_Visual">
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Base.stl" scale="0.00098 0.00098 0.00098"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision name="Base_Collision">
      <origin rpy="0 0 0" xyz="-0.0029 0.00016 0.027"/>
      <geometry>
        <cylinder length="0.05469" radius="0.0592"/>
      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT 1: WAIST — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="waist_joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.00345 -1e-05 0.04449"/>
    <parent link="base_link"/>
    <child link="waist_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="25.0" lower="-3.14159" upper="3.14159" velocity="3.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <!-- ═══════════════════════════════════════════════════════════
       LINK 2: WAIST — Orange waist bracket
       ═══════════════════════════════════════════════════════════ -->
  <link name="waist_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <mass value="0.20"/>
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.0002"/>
    </inertial>
    <visual name="Waist_Visual">
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Waist.stl" scale="0.00098 0.00098 0.00098"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Waist_Collision">
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <box size="0.08 0.05 0.04"/>
      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT 2: SHOULDER — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="shoulder_joint" type="revolute">
    <origin rpy="1.5708 0.03778 1.5708" xyz="0.00396 0.01369 0.03521"/>
    <parent link="waist_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="25.0" lower="-1.5708" upper="1.5708" velocity="3.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <!-- ═══════════════════════════════════════════════════════════
       LINK 3: UPPER ARM (Arm1) — Orange main link
       ═══════════════════════════════════════════════════════════ -->
  <link name="upper_arm_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.06 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.0002"/>
    </inertial>
    <visual name="Arm01_Visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm_01.stl" scale="0.00098 0.00098 0.00098"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm01_Collision">
      <origin rpy="0 0 0" xyz="-0.00032 0.058 0.00439"/>
      <geometry>
        <box size="0.038 0.082 0.020"/>
      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT 3: ELBOW — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="elbow_joint" type="revolute">
    <origin rpy="-0.0013 -3.14159 0.03778" xyz="-7e-05 0.11689 -0.00792"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="25.0" lower="-1.5708" upper="1.5708" velocity="3.5"/>
    <dynamics damping="0.1" friction="0.02"/>
  </joint>
  <!-- ═══════════════════════════════════════════════════════════
       LINK 4: FOREARM (Arm2) — Orange forearm housing
       ═══════════════════════════════════════════════════════════ -->
  <link name="forearm_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.06 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00018"/>
    </inertial>
    <visual name="Arm02_Visual">
      <origin rpy="-1.48894 -1.57209 1.57067" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm_02.stl" scale="0.00098 0.00098 0.00098"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm02_Collision">
      <origin rpy="-1.48879 -1.57209 1.57066" xyz="-0.00436 0.062 0.00738"/>
      <geometry>
        <box size="0.026 0.090 0.035"/>
      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT 4: WRIST PITCH (wrist) — SG90 Micro Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="wrist_pitch_joint" type="revolute">
    <origin rpy="-0.01458 3.14159 0" xyz="-0.0088 0.12752 -0.00487"/>
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="10.0" lower="-1.5708" upper="1.5708" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <!-- ═══════════════════════════════════════════════════════════
       LINK 5: WRIST (Arm3) — Orange wrist link
       ═══════════════════════════════════════════════════════════ -->
  <link name="wrist_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.02 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00006"/>
    </inertial>
    <visual name="Arm03_Visual">
      <origin rpy="1.2416 1.55752 1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm_03.stl" scale="0.00098 0.00098 0.00098"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm03_Collision">
      <origin rpy="1.24161 1.55752 1.5708" xyz="-0.00062 0.015 0.00049"/>
      <geometry>
        <box size="0.025 0.030 0.022"/>
      </geometry>
    </collision>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       SENSOR LINK: MPU6050 6-Axis IMU (Inside wrist link)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="wrist_link"/>
    <child link="imu_link"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       SENSOR LINK: WRIST CAMERA (In-Hand Gripper Vision)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="wrist_camera_link"/>
    <origin rpy="1.5708 0.0000 2.3358" xyz="0.025 0.050 -0.007"/>
  </joint>
  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <!-- ═══════════════════════════════════════════════════════════
       JOINT 6: GRIPPER (gripper) — SG90 Micro Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="gripper_joint" type="revolute">
    <origin rpy="-1.27431 -1.58408 1.5708" xyz="-0.02735 0.03009 -0.02013"/>
    <parent link="wrist_link"/>
    <child link="finger_left_1_link"/>
    <axis xyz="0 0 1.0"/>
    <limit effort="10.0" lower="0.0" upper="1.047" velocity="6.0"/>
    <dynamics damping="0.02" friction="0.005"/>
  </joint>
  <link name="finger_left_1_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <mass value="0.03"/>
      <inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.000015" iyz="0" izz="0.000015"/>
    </inertial>
    <visual name="Gripper1_Visual">
      <origin rpy="-1.86728 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Gripper1.002.stl" scale="1.0 1.0 1.0"/>
      </geometry>
