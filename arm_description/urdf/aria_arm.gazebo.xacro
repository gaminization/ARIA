<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Gazebo-Specific Configuration
     Plugins, sensors, materials for Gazebo Harmonic (gz-sim)
     Stage 1: CLEAN — all sensor noise set to zero
     ═══════════════════════════════════════════════════════════════ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aria_arm_gazebo">

  <!-- ═══════════════════════════════════════════════════════════
       gz_ros2_control PLUGIN — bridges Gazebo ↔ ros2_control
       Uses GazeboSimSystem for Gazebo Harmonic
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_control)/config/aria_controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       MATERIAL COLORS — Gazebo-specific (overrides URDF materials)
       ═══════════════════════════════════════════════════════════ -->

  <!-- Base: white -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.95 0.95 0.95 1</ambient>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Waist bracket: orange -->
  <gazebo reference="waist_link">
    <material>
      <ambient>0.95 0.55 0.10 1</ambient>
      <diffuse>0.95 0.55 0.10 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Upper arm: orange -->
  <gazebo reference="upper_arm_link">
    <material>
      <ambient>0.95 0.55 0.10 1</ambient>
      <diffuse>0.95 0.55 0.10 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Forearm: orange -->
  <gazebo reference="forearm_link">
    <material>
      <ambient>0.95 0.55 0.10 1</ambient>
      <diffuse>0.95 0.55 0.10 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Wrist: orange -->
  <gazebo reference="wrist_link">
    <material>
      <ambient>0.95 0.55 0.10 1</ambient>
      <diffuse>0.95 0.55 0.10 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Gripper holder: white -->
  <gazebo reference="gripper_holder_link">
    <material>
      <ambient>0.95 0.95 0.95 1</ambient>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Gear housing: white -->
  <gazebo reference="gear_housing_link">
    <material>
      <ambient>0.95 0.95 0.95 1</ambient>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </material>
  </gazebo>

  <!-- Left finger pair: blue -->
  <gazebo reference="finger_left_1_link">
    <material>
      <ambient>0.20 0.40 0.85 1</ambient>
      <diffuse>0.20 0.40 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </material>
  </gazebo>

  <!-- Right finger pair: blue -->
  <gazebo reference="finger_right_1_link">
    <material>
      <ambient>0.20 0.40 0.85 1</ambient>
      <diffuse>0.20 0.40 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </material>
  </gazebo>

  <!-- Cameras: dark gray -->
  <gazebo reference="top_camera_link">
    <material>
      <ambient>0.25 0.25 0.25 1</ambient>
      <diffuse>0.25 0.25 0.25 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <material>
      <ambient>0.25 0.25 0.25 1</ambient>
      <diffuse>0.25 0.25 0.25 1</diffuse>
    </material>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       TOP CAMERA SENSOR — Logitech C270
       1280×720, 60° HFOV, 30fps
       CLEAN: noise stddev = 0
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="top_camera_link">
    <sensor name="top_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>  <!-- 60 degrees -->
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>  <!-- CLEAN: no noise in Stage 1 -->
        </noise>
      </camera>
      <topic>top_camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       WRIST CAMERA SENSOR — ESP32-CAM
       640×480, 66° HFOV, 15fps
       CLEAN: noise stddev = 0
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.1519</horizontal_fov>  <!-- 66 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>  <!-- CLEAN: no noise in Stage 1 -->
        </noise>
      </camera>
      <topic>wrist_camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       IMU SENSOR — MPU6050 (on wrist_link)
       6-axis: 3-axis gyro + 3-axis accelerometer
       100 Hz update rate
       CLEAN: all noise set to zero
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="mpu6050_sim" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>  <!-- CLEAN -->
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <topic>mpu6050/imu_raw</topic>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT SENSORS — on gripper fingers
       Detect objects grasped between finger pairs
       Publishes to /gripper/contact
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="finger_left_1_link">
    <sensor name="gripper_contact_left" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_left_1_link_collision</collision>
      </contact>
      <topic>gripper/contact_left</topic>
    </sensor>
    <!-- Finger surface friction -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference="finger_right_1_link">
    <sensor name="gripper_contact_right" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_right_1_link_collision</collision>
      </contact>
      <topic>gripper/contact_right</topic>
    </sensor>
    <!-- Finger surface friction -->
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.8</mu>
            <mu2>0.8</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT FRICTION — realistic but not overdone for Stage 1
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="waist_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="shoulder_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="elbow_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_pitch_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_roll_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="gripper_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

</robot>
