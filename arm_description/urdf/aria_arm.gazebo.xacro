<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Gazebo-Specific Configuration
     Plugins, sensors, materials for Gazebo Classic 11
     Stage 1: CLEAN — all sensor noise set to zero
     ═══════════════════════════════════════════════════════════════ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aria_arm_gazebo">

  <!-- ═══════════════════════════════════════════════════════════
       gazebo_ros2_control PLUGIN — bridges Gazebo Classic ↔ ros2_control
       Uses GazeboSystem for Gazebo Classic 11
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so"
            name="gazebo_ros2_control">
      <parameters>$(find arm_control)/config/aria_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       ARIA INDUSTRIAL GRIPPER PLUGIN — High-Fidelity Grasp & Release
       ═══════════════════════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="libaria_gripper_plugin.so"
            name="aria_gripper_plugin">
      <ros>
        <namespace>/aria</namespace>
      </ros>
      <palm_link>wrist_link</palm_link>
      <max_attach_dist>0.14</max_attach_dist>
    </plugin>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       ROBUST JOINT DYNAMICS (Implicit Spring-Damper in ODE)
       Prevents joint constraint explosion and shearing forces
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="waist_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="shoulder_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="elbow_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="wrist_pitch_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="gripper_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="finger_mimic_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       MATERIAL COLORS — Gazebo Classic specific
       ═══════════════════════════════════════════════════════════ -->

  <!-- Base: white -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Waist bracket: orange -->
  <gazebo reference="waist_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Upper arm: orange -->
  <gazebo reference="upper_arm_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Forearm: orange -->
  <gazebo reference="forearm_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Wrist: orange -->
  <gazebo reference="wrist_link">
    <material>Gazebo/Orange</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Gripper holder: white -->
  <gazebo reference="gripper_holder_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Gear housing: white -->
  <gazebo reference="gear_housing_link">
    <material>Gazebo/White</material>
    <self_collide>false</self_collide>
    <kp>50000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.002</minDepth>
    <maxVel>0.05</maxVel>
  </gazebo>

  <!-- Left finger pair: blue -->
  <gazebo reference="finger_left_1_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>200000.0</kp>
    <kd>20.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <torsional>
      <ode>
        <coefficient>10.0</coefficient>
        <patch_radius>0.015</patch_radius>
      </ode>
    </torsional>
    <bounce>
      <restitution_coefficient>0.0</restitution_coefficient>
      <threshold>1000000.0</threshold>
    </bounce>
  </gazebo>

  <!-- Right finger pair: blue -->
  <gazebo reference="finger_right_1_link">
    <material>Gazebo/Blue</material>
    <self_collide>false</self_collide>
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>200000.0</kp>
    <kd>20.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.01</maxVel>
    <torsional>
      <ode>
        <coefficient>10.0</coefficient>
        <patch_radius>0.015</patch_radius>
      </ode>
    </torsional>
    <bounce>
      <restitution_coefficient>0.0</restitution_coefficient>
      <threshold>1000000.0</threshold>
    </bounce>
  </gazebo>

  <!-- Cameras: dark gray -->
  <gazebo reference="top_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="wrist_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Preserve sensor joints from being lumped into parent link -->
  <gazebo reference="wrist_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       WRIST CAMERA SENSOR — ESP32-CAM (attached to wrist_link)
       640×480, 66° HFOV, 15fps
       Uses libgazebo_ros_camera.so for Gazebo Classic
       CLEAN: noise stddev = 0
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="wrist_link">
    <sensor name="wrist_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <pose>0.025 0.050 -0.007 1.5708 0.0000 2.3358</pose>
      <camera>
        <horizontal_fov>1.75</horizontal_fov>  <!-- 100 degrees wide-angle lens -->
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>  <!-- CLEAN: no noise in Stage 1 -->
        </noise>
      </camera>
      <plugin name="wrist_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=/wrist_camera/image_raw</remapping>
          <remapping>~/camera_info:=/wrist_camera/camera_info</remapping>
          <remapping>~/depth/image_raw:=/wrist_camera/depth/image_raw</remapping>
          <remapping>~/depth/camera_info:=/wrist_camera/depth/camera_info</remapping>
        </ros>
        <camera_name>wrist_camera</camera_name>
        <frame_name>wrist_camera_link</frame_name>
        <min_depth>0.01</min_depth>
        <max_depth>5.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       IMU SENSOR — MPU6050 (on wrist_link)
       6-axis: 3-axis gyro + 3-axis accelerometer
       100 Hz update rate
       Uses libgazebo_ros_imu_sensor.so for Gazebo Classic
       CLEAN: all noise set to zero
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor name="mpu6050_sim" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/mpu6050/imu_raw</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       CONTACT SENSORS — on gripper fingers
       Detect objects grasped between finger pairs
       Uses libgazebo_ros_bumper.so for Gazebo Classic
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="finger_left_1_link">
    <sensor name="gripper_contact_left" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_left_1_link_fixed_joint_lump__finger_left_1_link_collision_1</collision>
      </contact>
      <plugin name="contact_left_controller" filename="libgazebo_ros_bumper.so">
        <ros>
          <remapping>~/out:=/gripper/contact_left</remapping>
        </ros>
        <frame_name>finger_left_1_link</frame_name>
      </plugin>
    </sensor>
    <!-- Finger surface friction -->
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="finger_right_1_link">
    <sensor name="gripper_contact_right" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>finger_right_1_link_fixed_joint_lump__finger_right_1_link_collision_1</collision>
      </contact>
      <plugin name="contact_right_controller" filename="libgazebo_ros_bumper.so">
        <ros>
          <remapping>~/out:=/gripper/contact_right</remapping>
        </ros>
        <frame_name>finger_right_1_link</frame_name>
      </plugin>
    </sensor>
    <!-- Finger surface friction -->
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT FRICTION — realistic but not overdone for Stage 1
       ═══════════════════════════════════════════════════════════ -->
  <gazebo reference="waist_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="shoulder_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="elbow_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_pitch_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="wrist_roll_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
  <gazebo reference="gripper_joint">
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

</robot>
