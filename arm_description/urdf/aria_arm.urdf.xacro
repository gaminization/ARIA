<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Robot Arm — URDF / Xacro Model
     5-DOF Articulated Robotic Arm + 1-DOF Parallel Gripper
     Actuator Limits: MG995 / MM995 (Waist, Shoulder, Elbow), SG90 (Wrist, Gripper)
     Sensors: Wrist Camera (ESP32-CAM), MPU6050 6-Axis IMU
     ═══════════════════════════════════════════════════════════════ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aria_arm">

  <!-- Include Gazebo-specific plugins and materials -->
  <xacro:include filename="$(find arm_description)/urdf/aria_arm.gazebo.xacro"/>

  <!-- ═══════════════════════════════════════════════════════════
       PROPERTIES & LIMITS
       ═══════════════════════════════════════════════════════════ -->
  <xacro:property name="arm_mesh_scale"     value="0.00098 0.00098 0.00098"/>
  <xacro:property name="gripper_mesh_scale" value="0.00098 0.00098 0.00098"/>

  <!-- Joint Angle Limits (radians) -->
  <xacro:property name="waist_lower"        value="-1.5708"/> <!-- -90 deg -->
  <xacro:property name="waist_upper"        value="1.5708"/>  <!-- +90 deg -->
  <xacro:property name="shoulder_lower"     value="-1.5708"/> <!-- -90 deg -->
  <xacro:property name="shoulder_upper"     value="1.5708"/>  <!-- +90 deg -->
  <xacro:property name="elbow_lower"        value="-1.5708"/> <!-- -90 deg -->
  <xacro:property name="elbow_upper"        value="1.5708"/>  <!-- +90 deg -->
  <xacro:property name="wrist_pitch_lower"  value="-1.5708"/> <!-- -90 deg -->
  <xacro:property name="wrist_pitch_upper"  value="1.5708"/>  <!-- +90 deg -->
  <xacro:property name="gripper_lower"      value="0.0"/>
  <xacro:property name="gripper_upper"      value="1.047"/>   <!-- 60 deg open -->

  <!-- Actuator Specifications (MG995 / MM995 & SG90 Servos) -->
  <xacro:property name="mg995_effort"       value="25.0"/>
  <xacro:property name="mg995_velocity"     value="3.5"/>
  <xacro:property name="sg90_effort"        value="10.0"/>
  <xacro:property name="sg90_velocity"      value="6.0"/>

  <!-- ═══════════════════════════════════════════════════════════
       MATERIALS (for RViz visualization)
       ═══════════════════════════════════════════════════════════ -->
  <material name="white"><color rgba="0.95 0.95 0.95 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.55 0.0 1.0"/></material>
  <material name="blue"><color rgba="0.15 0.35 0.85 1.0"/></material>
  <material name="dark_gray"><color rgba="0.25 0.25 0.25 1.0"/></material>

  <!-- ═══════════════════════════════════════════════════════════
       WORLD ANCHOR & FIXED TABLE ATTACHMENT
       ═══════════════════════════════════════════════════════════ -->
  <link name="world"/>

  <joint name="fixed_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.614" rpy="0 0 1.5708"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       LINK 1: BASE — White cylindrical base housing
       ═══════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="Base_Visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Base.stl" scale="${arm_mesh_scale}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision name="Base_Collision">
      <origin xyz="-0.0029 0.00016 0.027" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0592" length="0.05469"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT 1: WAIST — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="waist_joint" type="revolute">
    <origin xyz="-0.00345 -1e-05 0.04449" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="waist_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${waist_lower}" upper="${waist_upper}" effort="${mg995_effort}" velocity="${mg995_velocity}"/>
    <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       LINK 2: WAIST — Orange waist bracket
       ═══════════════════════════════════════════════════════════ -->
  <link name="waist_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="Waist_Visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Waist.stl" scale="${arm_mesh_scale}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Waist_Collision">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT 2: SHOULDER — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="shoulder_joint" type="revolute">
    <origin xyz="0.00396 0.01369 0.03521" rpy="1.5708 0.03778 1.5708"/>
    <parent link="waist_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${shoulder_lower}" upper="${shoulder_upper}" effort="${mg995_effort}" velocity="${mg995_velocity}"/>
    <dynamics damping="10.0" friction="1.0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       LINK 3: UPPER ARM (Arm1) — Orange main link
       ═══════════════════════════════════════════════════════════ -->
  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0 0.06 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="Arm01_Visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm 01.stl" scale="${arm_mesh_scale}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm01_Collision">
      <origin xyz="-0.00032 0.05624 0.00439" rpy="0 0 0"/>
      <geometry>
        <box size="0.04221 0.16277 0.02051"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT 3: ELBOW — MG995 / MM995 Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="elbow_joint" type="revolute">
    <origin xyz="-7e-05 0.11689 -0.00792" rpy="-0.0013 -3.14159 0.03778"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${elbow_lower}" upper="${elbow_upper}" effort="${mg995_effort}" velocity="${mg995_velocity}"/>
    <dynamics damping="8.0" friction="0.8"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       LINK 4: FOREARM (Arm2) — Orange forearm housing
       ═══════════════════════════════════════════════════════════ -->
  <link name="forearm_link">
    <inertial>
      <origin xyz="0 0.06 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="Arm02_Visual">
      <origin xyz="0 0 0" rpy="-1.48894 -1.57209 1.57067"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm 02.stl" scale="${arm_mesh_scale}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm02_Collision">
      <origin xyz="-0.00436 0.05688 0.00738" rpy="-1.48879 -1.57209 1.57066"/>
      <geometry>
        <box size="0.02681 0.16398 0.0384"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT 4: WRIST PITCH (wrist) — SG90 Micro Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="wrist_pitch_joint" type="revolute">
    <origin xyz="-0.0088 0.12752 -0.00487" rpy="-0.01458 3.14159 0"/>
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${wrist_pitch_lower}" upper="${wrist_pitch_upper}" effort="${sg90_effort}" velocity="${sg90_velocity}"/>
    <dynamics damping="4.0" friction="0.4"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       LINK 5: WRIST (Arm3) — Orange wrist link
       ═══════════════════════════════════════════════════════════ -->
  <link name="wrist_link">
    <inertial>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual name="Arm03_Visual">
      <origin xyz="0 0 0" rpy="1.2416 1.55752 1.5708"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Arm 03.stl" scale="${arm_mesh_scale}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision name="Arm03_Collision">
      <origin xyz="-0.00062 0.00019 0.00049" rpy="1.24161 1.55752 1.5708"/>
      <geometry>
        <box size="0.035 0.06 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       IMU SENSOR LINK (MPU6050 mounted on wrist)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="imu_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.002"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       WRIST CAMERA (ESP32-CAM mounted on wrist looking down at workspace)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="wrist_camera_link"/>
    <origin xyz="-0.02 0.055 0.0" rpy="0 0.52 1.5708"/>
  </joint>

  <link name="wrist_camera_link">
    <inertial>
      <mass value="0.010"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       JOINT 6: GRIPPER (gripper) — SG90 Micro Servo
       ═══════════════════════════════════════════════════════════ -->
  <joint name="gripper_joint" type="revolute">
    <origin xyz="-0.02735 0.03009 -0.02013" rpy="-1.27431 -1.58408 1.5708"/>
    <parent link="wrist_link"/>
    <child link="finger_left_1_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}" effort="${sg90_effort}" velocity="${sg90_velocity}"/>
    <dynamics damping="2.0" friction="0.2"/>
  </joint>

  <link name="finger_left_1_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual name="Gripper1_Visual">
      <origin xyz="0 0 0" rpy="-1.86728 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Gripper1.002.stl" scale="${gripper_mesh_scale}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision name="Gripper1_Collision">
      <origin xyz="0.00072 0.00044 0.03" rpy="-1.86728 0 0"/>
      <geometry>
        <box size="0.025 0.03 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       FINGER MIMIC JOINT — Right Finger (Blue, Mirrored)
       ═══════════════════════════════════════════════════════════ -->
  <joint name="finger_mimic_joint" type="revolute">
    <origin xyz="-0.02492 0.03048 0.00564" rpy="-1.25673 -1.55752 -1.57079"/>
    <parent link="wrist_link"/>
    <child link="finger_right_1_link"/>
    <axis xyz="0 0 1.0"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}" effort="${sg90_effort}" velocity="${sg90_velocity}"/>
    <mimic joint="gripper_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="2.0" friction="0.2"/>
  </joint>

  <link name="finger_right_1_link">
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual name="Gripper2_Visual">
      <origin xyz="0 0 0" rpy="-1.88476 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/stl/Gripper1.003.stl" scale="${gripper_mesh_scale}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision name="Gripper2_Collision">
      <origin xyz="-0.00072 0.00044 0.03" rpy="-1.88476 0 0"/>
      <geometry>
        <box size="0.025 0.03 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       ROS 2 CONTROL CONFIGURATION
       ═══════════════════════════════════════════════════════════ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="waist_joint">
      <command_interface name="position">
        <param name="min">${waist_lower}</param>
        <param name="max">${waist_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="shoulder_joint">
      <command_interface name="position">
        <param name="min">${shoulder_lower}</param>
        <param name="max">${shoulder_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position">
        <param name="min">${elbow_lower}</param>
        <param name="max">${elbow_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_pitch_joint">
      <command_interface name="position">
        <param name="min">${wrist_pitch_lower}</param>
        <param name="max">${wrist_pitch_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_joint">
      <command_interface name="position">
        <param name="min">${gripper_lower}</param>
        <param name="max">${gripper_upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
