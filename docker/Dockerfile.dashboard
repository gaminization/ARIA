# ═══════════════════════════════════════════════════════════════
# ARIA Dashboard — Lightweight Node.js container
# No ROS2, no GPU. Serves dashboard at port 3000.
# Connects to ROS2 via rosbridge WebSocket.
#
# Build: docker build -f docker/Dockerfile.dashboard -t aria:dashboard .
# ═══════════════════════════════════════════════════════════════
FROM node:20-alpine AS dashboard_build

WORKDIR /app

# Copy package files
COPY arm_dashboard/frontend/package*.json ./

# Install dependencies
RUN npm ci --production=false 2>/dev/null || npm install

# Copy source
COPY arm_dashboard/frontend/ .

# Build production bundle
RUN npm run build 2>/dev/null || true

# ── Production image ──
FROM node:20-alpine AS dashboard_runtime

WORKDIR /app

# Install serve for static hosting
RUN npm install -g serve

# Copy built files
COPY --from=dashboard_build /app/build ./build 2>/dev/null || true
COPY --from=dashboard_build /app/dist ./dist 2>/dev/null || true
COPY --from=dashboard_build /app/public ./public 2>/dev/null || true

# Copy the Python dashboard app as fallback
COPY arm_dashboard/ ./arm_dashboard/

# Install Python for the fallback dashboard
RUN apk add --no-cache python3 py3-pip && \
    pip3 install --no-cache-dir \
    aiohttp websockets jinja2 pyyaml 2>/dev/null || true

ENV ROS_BRIDGE_HOST=localhost
ENV ROS_BRIDGE_PORT=9090
ENV DASHBOARD_PORT=3000

EXPOSE 3000

# Try serving built frontend; fall back to Python dashboard
CMD ["sh", "-c", \
    "if [ -d /app/dist ]; then serve -s /app/dist -l ${DASHBOARD_PORT}; \
     elif [ -d /app/build ]; then serve -s /app/build -l ${DASHBOARD_PORT}; \
     else python3 -m arm_dashboard.app; fi"]
