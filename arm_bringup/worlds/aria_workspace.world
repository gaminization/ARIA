<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Workspace — Gazebo Classic 11 World
     Laboratory workstation environment
     - Arm mounted in table center, facing forward (+X)
     - Overhead camera integrated as static world sensor
     - Grasp targets sized for 4.5cm gripper aperture (2.8cm - 3.8cm)
     - Reachable manipulation arc (14cm - 18cm)
     - Target sorting dish & tray receptacles
     ═══════════════════════════════════════════════════════════════ -->
<sdf version="1.6">
  <world name="default">

    <!-- ═══ Physics Engine (ODE high-accuracy setup) ═══ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ═══ Gravity ═══ -->
    <gravity>0 0 -9.81</gravity>

    <!-- ═══ Scene settings ═══ -->
    <scene>
      <ambient>0.62 0.62 0.65 1.0</ambient>
      <background>0.82 0.84 0.88 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ═══════════════════════════════════════════════════════════
         GUI — Clean viewpoint focused on robot in table center
         ═══════════════════════════════════════════════════════════ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.48 -0.42 0.88 0 0.45 2.45</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ═══════════════════════════════════════════════════════════
         LIGHTING — Studio Lab Lighting
         ═══════════════════════════════════════════════════════════ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0.5 0.5 5.0 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 -0.3 -1.0</direction>
    </light>

    <light type="spot" name="table_spot">
      <pose>0.0 0.0 2.2 0 0 0</pose>
      <diffuse>0.85 0.82 0.75 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>4.5</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>0.9</inner_angle>
        <outer_angle>1.5</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══════════════════════════════════════════════════════════
         OVERHEAD CAMERA SENSOR (Logitech C270)
         Static world sensor — 1280x720 @ 30Hz
         ═══════════════════════════════════════════════════════════ -->
    <model name="overhead_camera_model">
      <static>true</static>
      <pose>0.15 0.0 1.45 0 0.85 3.14159</pose>
      <link name="camera_link">
        <sensor name="top_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.01</near><far>10.0</far></clip>
          </camera>
          <plugin name="overhead_camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/top_camera/image_raw</remapping>
              <remapping>~/camera_info:=/top_camera/camera_info</remapping>
            </ros>
            <camera_name>top_camera</camera_name>
            <frame_name>top_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ═══ Side Inspection Camera (Verification Only) ═══ -->
    <model name="side_inspection_rig">
      <static>true</static>
      <pose>0.52 -0.42 0.95 0 0.40 2.45</pose>
      <link name="link">
        <sensor name="side_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>10.0</far></clip>
          </camera>
          <plugin name="side_camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/side_camera/image_raw</remapping>
              <remapping>~/camera_info:=/side_camera/camera_info</remapping>
            </ros>
            <camera_name>side_camera</camera_name>
            <frame_name>side_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         GROUND / FLOOR — Hardwood workshop floor
         ═══════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         OPTICAL WORKSTATION TABLE (from iai_table_robot_description)
         Dimensions: 1.20m x 0.60m, Surface height at z = 0.608m
         ═══════════════════════════════════════════════════════════ -->
    <model name="optical_table">
      <static>true</static>
      <pose>0.60 0.30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>-0.60 -0.30 0.304 0 0 0</pose>
          <geometry>
            <box><size>1.20 0.60 0.608</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/table/complete_table.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         ROBOT MOUNTING PLATE (centered on optical table)
         ═══════════════════════════════════════════════════════════ -->
    <model name="arm_mounting_plate">
      <static>true</static>
      <pose>0.0 0.0 0.608 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>0.18 0.15 0.006</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/table/base_to_optical_table.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         GRASPABLE MANIPULATION OBJECTS (2.8cm - 3.8cm)
         Positioned within 14cm - 18cm reach radius in front of arm (+X)
         ═══════════════════════════════════════════════════════════ -->

    <!-- 1. Red Manipulation Cube (3.0 cm cube, 30g — Center) -->
    <model name="red_cube">
      <pose>0.16 0.0 0.623 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.030</mass>
          <inertia><ixx>4.5e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4.5e-6</iyy><iyz>0</iyz><izz>4.5e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.030 0.030 0.030</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.030 0.030 0.030</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. Yellow Sorting Block (2.8 cm cube, 25g — Right Reach Zone) -->
    <model name="yellow_block">
      <pose>0.14 -0.07 0.622 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.025</mass>
          <inertia><ixx>3.2e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.2e-6</iyy><iyz>0</iyz><izz>3.2e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.028 0.028 0.028</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.028 0.028 0.028</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Blue Grasp Cylinder (3.0 cm dia, 4.0 cm tall, 30g — Left Reach Zone) -->
    <model name="blue_cylinder">
      <pose>0.14 0.07 0.628 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.030</mass>
          <inertia><ixx>5.6e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5.6e-6</iyy><iyz>0</iyz><izz>3.4e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.015</radius><length>0.040</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.015</radius><length>0.040</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. Mini Beverage Can (3.2 cm dia, 6.0 cm tall, 35g) -->
    <model name="mini_can">
      <pose>0.18 -0.05 0.638 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.035</mass>
          <inertia><ixx>1.2e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.2e-5</iyy><iyz>0</iyz><izz>4.5e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.016</radius><length>0.060</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.016</radius><length>0.060</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 5. Espresso Coffee Cup (3.8 cm dia, 4.0 cm tall, 25g) -->
    <model name="espresso_cup">
      <pose>0.18 0.05 0.628 0 0 0.3</pose>
      <link name="body">
        <inertial>
          <mass>0.025</mass>
          <inertia><ixx>5e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>5e-6</iyy><iyz>0</iyz><izz>4.5e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.019</radius><length>0.040</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/objects/Dishes_Mug.dae</uri>
              <scale>0.0038 0.0038 0.004</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- 6. Banana (12 cm long, 2 cm diameter cylinder, 40g — Center-Front Table) -->
    <model name="banana">
      <pose>0.20 0.00 0.668 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.040</mass>
          <inertia><ixx>4.2e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4.2e-5</iyy><iyz>0</iyz><izz>2.0e-6</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.010</radius><length>0.120</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.010</radius><length>0.120</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.85 0.10 1</ambient>
            <diffuse>0.95 0.85 0.10 1</diffuse>
            <specular>0.4 0.35 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         TARGET SORTING RECEPTACLES (Plate & Tray Drop Zones)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Target Sorting Dish (Right Drop Zone, 14 cm diameter) -->
    <model name="sorting_dish">
      <pose>0.10 -0.16 0.608 0 0 0</pose>
      <link name="body">
        <collision name="c">
          <pose>0 0 0.008 0 0 0</pose>
          <geometry><cylinder><radius>0.070</radius><length>0.016</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/objects/plate.dae</uri>
              <scale>0.14 0.14 0.14</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Target Sorting Box / Tray (Left Drop Zone, 16cm x 12cm) -->
    <model name="sorting_box">
      <pose>0.10 0.16 0.608 0 0 0</pose>
      <link name="body">
        <collision name="c">
          <pose>0 0 0.010 0 0 0</pose>
          <geometry><box><size>0.16 0.12 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/objects/tray.dae</uri>
              <scale>0.5 0.5 0.5</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
