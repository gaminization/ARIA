<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Workspace — Gazebo Classic 11 World
     Enhanced lab/workshop environment with realistic lighting
     ═══════════════════════════════════════════════════════════════ -->
<sdf version="1.6">
  <world name="aria_workspace">

    <!-- ═══ Physics ═══ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>200</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ═══ Gravity ═══ -->
    <gravity>0 0 -9.81</gravity>

    <!-- ═══ Atmosphere ═══ -->
    <atmosphere type="adiabatic"/>

    <!-- ═══ Scene settings ═══ -->
    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.15 0.18 0.25 1.0</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>2</speed>
        </clouds>
      </sky>
      <grid>false</grid>
    </scene>

    <!-- ═══════════════════════════════════════════════════════════
         GUI — Camera initial viewpoint
         ═══════════════════════════════════════════════════════════ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.2 -0.8 1.6 0 0.45 2.4</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ═══════════════════════════════════════════════════════════
         LIGHTING — Warm workshop atmosphere
         ═══════════════════════════════════════════════════════════ -->

    <!-- Main overhead light (warm white, casts shadows) -->
    <light type="point" name="overhead_light">
      <pose>0.0 0.0 2.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.5 0.48 0.42 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.3</constant>
        <linear>0.1</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Desk lamp (focused warm light on workspace) -->
    <light type="spot" name="desk_lamp_light">
      <pose>-0.05 -0.25 1.6 0 0.6 0.3</pose>
      <diffuse>1.0 0.95 0.80 1</diffuse>
      <specular>0.6 0.55 0.45 1</specular>
      <attenuation>
        <range>3</range>
        <constant>0.2</constant>
        <linear>0.15</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
      <direction>0.1 0.2 -1</direction>
      <spot>
        <inner_angle>0.6</inner_angle>
        <outer_angle>1.2</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Fill light from side (soft blue-ish, no shadows) -->
    <light type="directional" name="fill_light">
      <pose>-2 2 3 0 0 0</pose>
      <diffuse>0.25 0.28 0.35 1</diffuse>
      <specular>0.05 0.05 0.08 1</specular>
      <direction>0.5 -0.5 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══════════════════════════════════════════════════════════
         GROUND / FLOOR — dark wood/concrete lab floor
         ═══════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>8 8</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/WoodFloor</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         ROOM — Walls and ceiling for indoor environment
         ═══════════════════════════════════════════════════════════ -->
    <model name="room">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Back wall -->
      <link name="wall_back">
        <pose>-1.5 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.05 4.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 4.0 3.0</size></box></geometry>
          <material>
            <ambient>0.82 0.82 0.80 1</ambient>
            <diffuse>0.85 0.85 0.83 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Left wall -->
      <link name="wall_left">
        <pose>0.5 2.0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.0 0.05 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.05 3.0</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.85 1</ambient>
            <diffuse>0.83 0.85 0.88 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Right wall -->
      <link name="wall_right">
        <pose>0.5 -2.0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>4.0 0.05 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.05 3.0</size></box></geometry>
          <material>
            <ambient>0.80 0.82 0.85 1</ambient>
            <diffuse>0.83 0.85 0.88 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Ceiling -->
      <link name="ceiling">
        <pose>0.5 0 3.0 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>4.0 4.0 0.02</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.90 1</ambient>
            <diffuse>0.95 0.95 0.93 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Fixed joints -->
      <joint name="j1" type="fixed"><parent>wall_back</parent><child>wall_left</child></joint>
      <joint name="j2" type="fixed"><parent>wall_back</parent><child>wall_right</child></joint>
      <joint name="j3" type="fixed"><parent>wall_back</parent><child>ceiling</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         WORKBENCH — Heavy-duty lab table
         80×60×75cm, thick wooden top, metal frame legs
         ═══════════════════════════════════════════════════════════ -->
    <model name="workbench">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Table top: 80×60×3cm at 75cm -->
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="top_collision">
          <geometry><box><size>0.82 0.62 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <geometry><box><size>0.82 0.62 0.03</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>

      <!-- Front-left leg -->
      <link name="leg_fl">
        <pose>0.37 0.27 0.365 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.04 0.04 0.73</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.73</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <!-- Front-right leg -->
      <link name="leg_fr">
        <pose>0.37 -0.27 0.365 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.04 0.04 0.73</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.73</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <!-- Back-left leg -->
      <link name="leg_bl">
        <pose>-0.37 0.27 0.365 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.04 0.04 0.73</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.73</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <!-- Back-right leg -->
      <link name="leg_br">
        <pose>-0.37 -0.27 0.365 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.04 0.04 0.73</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.73</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>

      <!-- Cross-brace (under table) -->
      <link name="cross_brace_front">
        <pose>0.37 0 0.10 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.02 0.50 0.02</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="cross_brace_back">
        <pose>-0.37 0 0.10 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.02 0.50 0.02</size></box></geometry>
          <material>
            <ambient>0.30 0.30 0.32 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Fixed joints -->
      <joint name="j_fl" type="fixed"><parent>table_top</parent><child>leg_fl</child></joint>
      <joint name="j_fr" type="fixed"><parent>table_top</parent><child>leg_fr</child></joint>
      <joint name="j_bl" type="fixed"><parent>table_top</parent><child>leg_bl</child></joint>
      <joint name="j_br" type="fixed"><parent>table_top</parent><child>leg_br</child></joint>
      <joint name="j_cbf" type="fixed"><parent>table_top</parent><child>cross_brace_front</child></joint>
      <joint name="j_cbb" type="fixed"><parent>table_top</parent><child>cross_brace_back</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         CAMERA STAND — holds the top camera (Logitech C270)
         Position: 40cm in front, 80cm above table surface
         ═══════════════════════════════════════════════════════════ -->
    <model name="camera_stand">
      <static>true</static>
      <pose>0.40 0.0 0.76 0 0 0</pose>

      <!-- Base plate -->
      <link name="base_plate">
        <pose>0 0 0 0 0 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry></collision>
      </link>

      <!-- Pole -->
      <link name="stand_pole">
        <pose>0 0 0.40 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.008</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.008</radius><length>0.80</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>

      <joint name="j_pole" type="fixed"><parent>base_plate</parent><child>stand_pole</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         DESK LAMP MODEL (visual only)
         ═══════════════════════════════════════════════════════════ -->
    <model name="desk_lamp">
      <static>true</static>
      <pose>-0.30 -0.25 0.765 0 0 0.4</pose>

      <!-- Lamp base -->
      <link name="lamp_base">
        <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.015</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.20 0.20 0.25 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>

      <!-- Lamp arm -->
      <link name="lamp_arm">
        <pose>0 0 0.20 0 0.3 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.005</radius><length>0.40</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.5 0.5 0.52 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>

      <!-- Lamp shade -->
      <link name="lamp_shade">
        <pose>0.06 0 0.38 0 0.4 0</pose>
        <visual name="v"><geometry><cylinder><radius>0.04</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.15 0.15 0.18 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>

      <joint name="j1" type="fixed"><parent>lamp_base</parent><child>lamp_arm</child></joint>
      <joint name="j2" type="fixed"><parent>lamp_arm</parent><child>lamp_shade</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         WALL SHELF (behind the workspace, on back wall)
         ═══════════════════════════════════════════════════════════ -->
    <model name="wall_shelf">
      <static>true</static>
      <pose>-1.40 0 0 0 0 0</pose>

      <!-- Shelf board 1 -->
      <link name="shelf_1">
        <pose>0 0 1.2 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.25 1.0 0.02</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.25 1.0 0.02</size></box></geometry></collision>
      </link>

      <!-- Shelf board 2 -->
      <link name="shelf_2">
        <pose>0 0 1.65 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.25 1.0 0.02</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.25 1.0 0.02</size></box></geometry></collision>
      </link>

      <!-- Shelf brackets (left & right, for each shelf) -->
      <link name="bracket_1l">
        <pose>0.05 -0.45 1.1 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.15 0.02 0.02</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
      <link name="bracket_1r">
        <pose>0.05 0.45 1.1 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.15 0.02 0.02</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
      <link name="bracket_2l">
        <pose>0.05 -0.45 1.55 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.15 0.02 0.02</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>
      <link name="bracket_2r">
        <pose>0.05 0.45 1.55 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.15 0.02 0.02</size></box></geometry>
          <material><ambient>0.4 0.4 0.42 1</ambient><diffuse>0.5 0.5 0.52 1</diffuse></material>
        </visual>
      </link>

      <!-- Some items on shelf 1 (books / boxes) -->
      <link name="book_stack">
        <pose>0 -0.2 1.24 0 0 0.1</pose>
        <visual name="v"><geometry><box><size>0.12 0.18 0.06</size></box></geometry>
          <material>
            <ambient>0.20 0.35 0.60 1</ambient>
            <diffuse>0.25 0.40 0.65 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="toolbox">
        <pose>0 0.25 1.26 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.20 0.12 0.10</size></box></geometry>
          <material>
            <ambient>0.75 0.15 0.10 1</ambient>
            <diffuse>0.80 0.18 0.12 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>

      <!-- Item on shelf 2 -->
      <link name="supply_box">
        <pose>0 0.0 1.70 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.15 0.20 0.08</size></box></geometry>
          <material>
            <ambient>0.65 0.60 0.45 1</ambient>
            <diffuse>0.70 0.65 0.50 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Fixed joints -->
      <joint name="js1" type="fixed"><parent>shelf_1</parent><child>bracket_1l</child></joint>
      <joint name="js2" type="fixed"><parent>shelf_1</parent><child>bracket_1r</child></joint>
      <joint name="js3" type="fixed"><parent>shelf_2</parent><child>bracket_2l</child></joint>
      <joint name="js4" type="fixed"><parent>shelf_2</parent><child>bracket_2r</child></joint>
      <joint name="js5" type="fixed"><parent>shelf_1</parent><child>book_stack</child></joint>
      <joint name="js6" type="fixed"><parent>shelf_1</parent><child>toolbox</child></joint>
      <joint name="js7" type="fixed"><parent>shelf_2</parent><child>supply_box</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         TEST OBJECTS — Manipulation targets on table
         All placed on table surface (z = 0.765 + half_height)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Red Cube: 50mm, 50g -->
    <model name="red_cube">
      <pose>0.20 0.05 0.790 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.083e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-5</iyy><iyz>0</iyz>
            <izz>2.083e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue Cylinder: r=30mm, h=150mm, 200g (water bottle) -->
    <model name="blue_cylinder">
      <pose>0.25 -0.05 0.840 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>4.275e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.275e-4</iyy><iyz>0</iyz>
            <izz>9.0e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green Sphere: r=20mm, 30g (small ball) -->
    <model name="green_sphere">
      <pose>0.18 -0.08 0.785 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>4.8e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.8e-6</iyy><iyz>0</iyz>
            <izz>4.8e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

