<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Tester Workspace — Gazebo Classic 11 World
     Curated Distinct Benchmark Suite & Original Sizing Jenga Arena
     ═══════════════════════════════════════════════════════════════ -->
<sdf version="1.6">
  <world name="default">

    <!-- ═══ Physics Engine (Stable Anti-Glitch ODE Setup) ═══ -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.25</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ═══ Gravity ═══ -->
    <gravity>0 0 -9.81</gravity>

    <!-- ═══ Scene settings ═══ -->
    <scene>
      <ambient>0.70 0.70 0.72 1.0</ambient>
      <background>0.84 0.86 0.90 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ═══ GUI Viewpoint ═══ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.62 -0.52 1.05 0 0.52 2.42</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ═══ Lighting ═══ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0.5 0.5 5.0 0 0 0</pose>
      <diffuse>0.92 0.92 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.3 -1.0</direction>
    </light>

    <light type="spot" name="table_spot">
      <pose>0.0 0.0 2.2 0 0 0</pose>
      <diffuse>0.92 0.90 0.85 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>4.5</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
      <spot>
        <inner_angle>1.2</inner_angle>
        <outer_angle>1.8</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="workspace_fill_light">
      <pose>0.0 0.0 1.8 0 0 0</pose>
      <diffuse>0.48 0.48 0.50 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>3.5</range>
        <constant>0.6</constant>
        <linear>0.06</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══ Overhead Sensor Rig ═══ -->
    <model name="overhead_sensor_rig">
      <static>true</static>
      <pose>0.0 0.0 1.45 0 1.5708 0</pose>
      <link name="sensor_mount_link">
        <sensor name="realsense_d435" type="depth">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.35</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>4.0</far></clip>
          </camera>
          <plugin name="realsense_d435_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/camera/color/image_raw</remapping>
              <remapping>~/depth/image_raw:=/camera/aligned_depth_to_color/image_raw</remapping>
              <remapping>~/camera_info:=/camera/color/camera_info</remapping>
              <remapping>~/depth/camera_info:=/camera/depth/camera_info</remapping>
              <remapping>~/points:=/camera/depth/points</remapping>
            </ros>
            <camera_name>camera</camera_name>
            <frame_name>camera_depth_optical_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>3.0</max_depth>
          </plugin>
        </sensor>

        <sensor name="top_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.25</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>10.0</far></clip>
          </camera>
          <plugin name="overhead_camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/top_camera/image_raw</remapping>
              <remapping>~/camera_info:=/top_camera/camera_info</remapping>
            </ros>
            <camera_name>top_camera</camera_name>
            <frame_name>top_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ═══ Side Inspection Camera ═══ -->
    <model name="side_inspection_rig">
      <static>true</static>
      <pose>0.52 -0.42 0.95 0 0.40 2.45</pose>
      <link name="link">
        <sensor name="side_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.01</near><far>10.0</far></clip>
          </camera>
          <plugin name="side_camera_driver" filename="libgazebo_ros_camera.so">
            <ros>
              <remapping>~/image_raw:=/side_camera/image_raw</remapping>
              <remapping>~/camera_info:=/side_camera/camera_info</remapping>
            </ros>
            <camera_name>side_camera</camera_name>
            <frame_name>side_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ═══ Ground Plane ═══ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodFloor</name></script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Optical Table ═══ -->
    <model name="optical_table">
      <static>true</static>
      <pose>0.60 0.30 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>-0.60 -0.30 0.304 0 0 0</pose>
          <geometry><box><size>1.20 0.60 0.608</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact><ode><kp>100000.0</kp><kd>100.0</kd><min_depth>0.001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh><uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/table/complete_table.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ═══ Arm Mounting Plate ═══ -->
    <model name="arm_mounting_plate">
      <static>true</static>
      <pose>0.0 0.0 0.608 0 0 1.5708</pose>
      <link name="link">
        <collision name="c">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>0.18 0.15 0.006</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry>
            <mesh><uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/table/base_to_optical_table.stl</uri></mesh>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.88 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Workspace Calibration Mat ═══ -->
    <model name="workspace_calibration_mat">
      <static>true</static>
      <pose>0.0 0.0 0.6081 0 0 0</pose>
      <link name="mat_link">
        <visual name="mat_visual">
