<?xml version="1.0"?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Workspace — Gazebo Harmonic World (SDF)
     Clean environment for Stage 1: no complex textures, no clutter
     Physics: DART, 1ms step, real-time factor 1.0
     ═══════════════════════════════════════════════════════════════ -->
<sdf version="1.9">
  <world name="aria_workspace">

    <!-- ═══ Physics Configuration ═══ -->
    <physics name="dart_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ═══ Required System Plugins ═══ -->
    <!-- Physics engine -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <!-- User interactive commands -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- Scene broadcaster for visualization -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensor processing -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU system -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- Contact system -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- ═══ Gravity ═══ -->
    <gravity>0 0 -9.81</gravity>

    <!-- ═══ Atmosphere ═══ -->
    <atmosphere type="adiabatic"/>

    <!-- ═══════════════════════════════════════════════════════════
         LIGHTING — Clean directional, no shadows for Stage 1
         ═══════════════════════════════════════════════════════════ -->
    <light type="directional" name="main_light">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0 0.2 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="directional" name="fill_light">
      <pose>-2 -2 3 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 0.5 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ═══════════════════════════════════════════════════════════
         GROUND PLANE
         ═══════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         TABLE — Standard desk 80×60×75cm
         Arm mounts on left-center at xyz="-0.15 0.0 0.76"
         ═══════════════════════════════════════════════════════════ -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Table top: 80×60×2cm, at 75cm height -->
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="top_collision">
          <geometry>
            <box><size>0.80 0.60 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <geometry>
            <box><size>0.80 0.60 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.7 0.5 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Table legs: 4 legs, each 3cm diameter, 74cm tall -->
      <link name="leg_front_left">
        <pose>0.35 0.25 0.37 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_front_right">
        <pose>0.35 -0.25 0.37 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_back_left">
        <pose>-0.35 0.25 0.37 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
      <link name="leg_back_right">
        <pose>-0.35 -0.25 0.37 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.015</radius><length>0.74</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>

      <!-- Fixed joints connecting legs to table top -->
      <joint name="leg_fl_joint" type="fixed"><parent>table_top</parent><child>leg_front_left</child></joint>
      <joint name="leg_fr_joint" type="fixed"><parent>table_top</parent><child>leg_front_right</child></joint>
      <joint name="leg_bl_joint" type="fixed"><parent>table_top</parent><child>leg_back_left</child></joint>
      <joint name="leg_br_joint" type="fixed"><parent>table_top</parent><child>leg_back_right</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         CAMERA STAND — holds the top camera (Logitech C270)
         Position: 40cm in front, 80cm above table surface
         ═══════════════════════════════════════════════════════════ -->
    <model name="camera_stand">
      <static>true</static>
      <pose>0.40 0.0 0.76 0 0 0</pose>
      <link name="stand_pole">
        <pose>0 0 0.40 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.015</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.015</radius><length>0.80</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         TEST OBJECTS — Simple colored shapes for manipulation testing
         All placed on table surface (z = 0.76 + half_height)
         ═══════════════════════════════════════════════════════════ -->

    <!-- Red Cube: 50mm, 50g, positioned in workspace -->
    <model name="red_cube">
      <pose>0.20 0.05 0.785 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>2.083e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-5</iyy><iyz>0</iyz>
            <izz>2.083e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
            <specular>0.4 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Blue Cylinder: r=30mm, h=150mm, 200g -->
    <model name="blue_cylinder">
      <pose>0.25 -0.05 0.835 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>4.275e-4</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.275e-4</iyy><iyz>0</iyz>
            <izz>9.0e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.15</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.53 0.90 1</ambient>
            <diffuse>0.12 0.53 0.90 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Green Sphere: r=20mm, 30g -->
    <model name="green_sphere">
      <pose>0.18 -0.08 0.78 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>4.8e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.8e-6</iyy><iyz>0</iyz>
            <izz>4.8e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material>
            <ambient>0.26 0.63 0.28 1</ambient>
            <diffuse>0.26 0.63 0.28 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow Block: 80×40×30mm, 100g -->
    <model name="yellow_block">
      <pose>0.30 0.08 0.775 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>2.083e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>6.083e-5</iyy><iyz>0</iyz>
            <izz>6.667e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.04 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.04 0.03</size></box></geometry>
          <material>
            <ambient>0.99 0.85 0.21 1</ambient>
            <diffuse>0.99 0.85 0.21 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- White Box: target container, open-top 150×100×80mm, 100g -->
    <model name="white_box">
      <static>true</static>
      <pose>0.28 -0.12 0.76 0 0 0</pose>

      <!-- Bottom -->
      <link name="bottom">
        <pose>0 0 0.002 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.10 0.004</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.10 0.004</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
      <!-- Front wall -->
      <link name="front_wall">
        <pose>0.073 0 0.042 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.004 0.10 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.004 0.10 0.08</size></box></geometry>
          <material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
      <!-- Back wall -->
      <link name="back_wall">
        <pose>-0.073 0 0.042 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.004 0.10 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.004 0.10 0.08</size></box></geometry>
          <material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
      <!-- Left wall -->
      <link name="left_wall">
        <pose>0 0.048 0.042 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.004 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.004 0.08</size></box></geometry>
          <material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>
      <!-- Right wall -->
      <link name="right_wall">
        <pose>0 -0.048 0.042 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.004 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.004 0.08</size></box></geometry>
          <material><ambient>0.90 0.90 0.90 1</ambient><diffuse>0.90 0.90 0.90 1</diffuse></material>
        </visual>
      </link>

      <joint name="j_front"  type="fixed"><parent>bottom</parent><child>front_wall</child></joint>
      <joint name="j_back"   type="fixed"><parent>bottom</parent><child>back_wall</child></joint>
      <joint name="j_left"   type="fixed"><parent>bottom</parent><child>left_wall</child></joint>
      <joint name="j_right"  type="fixed"><parent>bottom</parent><child>right_wall</child></joint>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         APRILTAG BOARD — for calibration in Stage 2
         Solid white placeholder for now
         ═══════════════════════════════════════════════════════════ -->
    <model name="apriltag_board">
      <static>true</static>
      <pose>0.35 0.20 0.76 0 0 0</pose>
      <link name="board">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.001</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
