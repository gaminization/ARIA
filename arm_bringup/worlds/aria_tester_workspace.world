<?xml version="1.0" ?>
<!-- ═══════════════════════════════════════════════════════════════
     ARIA Tester Workspace - World Definition (Gazebo Classic 11)
     Features:
       1. IAI Precision Optical Breadboard Table
       2. Multi-Affordance Benchmark Suite (Bullet3, YCB, Everyday Items)
       3. Authentic 4-Tier Cross-Stacked Jenga Arena
       4. Multi-Camera Rig (Logitech C270 Top Overhead + Multi-Angle Diagnostic Cameras)
       5. Robust Non-Exploding Primitive Collisions & Controlled Dynamic Damping
     ═══════════════════════════════════════════════════════════════ -->
<sdf version="1.6">
  <world name="aria_tester_workspace">

    <gravity>0 0 -9.81</gravity>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.25</sor>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.05</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global Key Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Soft Workspace Diffuse Light -->
    <light name="bench_soft_light" type="point">
      <pose>0.0 0.0 2.2 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>6.0</range>
        <constant>0.6</constant>
        <linear>0.02</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <!-- ═══════════════════════════════════════════════════════════
         IAI OPTICAL BREADBOARD MANIPULATION BENCH (Z_surface = 0.608 m)
         ═══════════════════════════════════════════════════════════ -->
    <model name="iai_optical_table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Aluminum Extrusion Frame Legs -->
      <link name="table_legs">
        <visual name="leg_fl"><pose> 0.38  0.38 0.295 0 0 0</pose><geometry><box><size>0.04 0.04 0.59</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg_fr"><pose> 0.38 -0.38 0.295 0 0 0</pose><geometry><box><size>0.04 0.04 0.59</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg_bl"><pose>-0.38  0.38 0.295 0 0 0</pose><geometry><box><size>0.04 0.04 0.59</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <visual name="leg_br"><pose>-0.38 -0.38 0.295 0 0 0</pose><geometry><box><size>0.04 0.04 0.59</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="legs_c"><pose>0 0 0.295 0 0 0</pose><geometry><box><size>0.80 0.80 0.59</size></box></geometry></collision>
      </link>

      <!-- Optical Breadboard Top Plate -->
      <link name="table_top">
        <pose>0 0 0.599 0 0 0</pose>
        <collision name="top_c"><geometry><box><size>0.80 0.80 0.018</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="top_v"><geometry><box><size>0.80 0.80 0.018</size></box></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
      </link>

      <!-- Antistatic High-Contrast Work Mat -->
      <link name="work_mat">
        <pose>0 0 0.6081 0 0 0</pose>
        <visual name="mat_v"><geometry><box><size>0.62 0.62 0.0002</size></box></geometry><material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.40 0.43 0.48 1</diffuse></material></visual>
      </link>

      <!-- Pedestal Stand 1 (Left Wing) -->
      <link name="pedestal_left">
        <pose>-0.18 0.22 0.618 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.045</radius><length>0.020</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.045</radius><length>0.020</length></cylinder></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>

      <!-- Pedestal Stand 2 (Right Wing) -->
      <link name="pedestal_right">
        <pose>-0.18 -0.22 0.618 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.045</radius><length>0.020</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.045</radius><length>0.020</length></cylinder></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         CAMERA SENSORS RIG
         ═══════════════════════════════════════════════════════════ -->
    <!-- Logitech C270 Top Overhead Camera -->
    <model name="logitech_c270_overhead">
      <static>true</static>
      <pose>0.0 0.0 1.45 0 1.570796 1.570796</pose>
      <link name="c270_optical_link">
        <sensor name="top_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera name="top">
            <horizontal_fov>1.047198</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
          <plugin name="top_camera_controller" filename="libgazebo_ros_camera.so">
            <ros><remapping>image_raw:=/top_camera/image_raw</remapping><remapping>camera_info:=/top_camera/camera_info</remapping></ros>
            <camera_name>top_camera</camera_name>
            <frame_name>top_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Side Diagnostic 45-deg Perspective Camera -->
    <model name="side_diagnostic_camera">
      <static>true</static>
      <pose>0.58 -0.45 0.95 0 0.48 2.45</pose>
      <link name="side_cam_link">
        <sensor name="side_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30.0</update_rate>
          <camera name="side">
            <horizontal_fov>1.085</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>6.0</far></clip>
          </camera>
          <plugin name="side_camera_controller" filename="libgazebo_ros_camera.so">
            <ros><remapping>image_raw:=/side_camera/image_raw</remapping><remapping>camera_info:=/side_camera/camera_info</remapping></ros>
            <camera_name>side_camera</camera_name>
            <frame_name>side_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         SECTOR 1: YCB & GROCERY BENCHMARKS (Front Arc, +X)
         ═══════════════════════════════════════════════════════════ -->

    <!-- 1. Fresh Banana -->
    <model name="bullet_banana">
      <pose>0.17 -0.06 0.6085 0 0 -0.4</pose>
      <link name="body">
        <inertial>
          <mass>0.15</mass>
          <inertia><ixx>1.5e-4</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.5e-4</iyy><iyz>0</iyz><izz>5.0e-5</izz></inertia>
        </inertial>
        <velocity_decay><linear>0.05</linear><angular>0.05</angular></velocity_decay>
        <collision name="c">
          <pose>0 0 0.015 0 0 0</pose>
          <geometry><cylinder><radius>0.020</radius><length>0.15</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry>
            <mesh>
              <uri>file:///home/gaminizer/Projects/ARIA/install/arm_description/share/arm_description/meshes/bullet/banana.obj</uri>
              <scale>0.85 0.85 0.85</scale>
            </mesh>
          </geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>1.0 0.9 0.12 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
      </link>
    </model>

