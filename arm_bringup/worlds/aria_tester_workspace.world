    <!-- ═══════════════════════════════════════════════════════════
         SECTOR 4: ORIGINAL STYLING & SIZING JENGA ARENA (Rear Center, -X)
         4-Tier Cross-Stacked Tower (75x25x15mm) + Free Practice Blocks
         ═══════════════════════════════════════════════════════════ -->

    <!-- Jenga Tower Tier 1 (Base Wood Block, 75x25x15mm) -->
    <model name="jenga_tower_b1">
      <pose>-0.17 0.00 0.6085 0 0 0</pose>
      <link name="body">
