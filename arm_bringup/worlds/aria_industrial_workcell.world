            <diffuse>0.15 0.60 0.35 1</diffuse>
            <specular>0.6 0.7 0.6 1</specular>
          </material>
        </visual>
        <!-- 4 Machined Pocket Visuals for 2x2 Assembly Grid -->
        <visual name="pocket_1"><pose>-0.035 -0.035 0.0151 0 0 0</pose><geometry><box><size>0.036 0.036 0.001</size></box></geometry><material><ambient>0.05 0.25 0.15 1</ambient></material></visual>
        <visual name="pocket_2"><pose> 0.035 -0.035 0.0151 0 0 0</pose><geometry><box><size>0.036 0.036 0.001</size></box></geometry><material><ambient>0.05 0.25 0.15 1</ambient></material></visual>
        <visual name="pocket_3"><pose>-0.035  0.035 0.0151 0 0 0</pose><geometry><box><size>0.036 0.036 0.001</size></box></geometry><material><ambient>0.05 0.25 0.15 1</ambient></material></visual>
        <visual name="pocket_4"><pose> 0.035  0.035 0.0151 0 0 0</pose><geometry><box><size>0.036 0.036 0.001</size></box></geometry><material><ambient>0.05 0.25 0.15 1</ambient></material></visual>
        <!-- Label Bar: "QC PASSED / ASSEMBLY" -->
        <visual name="pass_label">
          <pose>0 -0.070 0.0155 0 0 0</pose>
          <geometry><box><size>0.13 0.010 0.001</size></box></geometry>
          <material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1.0 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         OUTPUT 2: DEFECT / REJECT BIN
         Positioned at (0.190, -0.150, 0.608) — Kinematically aligned with reject_drop
         Industrial Red Polypropylene Scrap Bin with High Walls & Zero-Restitution Landing.
         ═══════════════════════════════════════════════════════════ -->
    <model name="reject_bin">
      <static>true</static>
      <pose>0.190 -0.150 0.608 0 0 0</pose>
      <link name="bin_link">
        <!-- Bin Bottom -->
        <collision name="bottom_col">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>0.12 0.14 0.010</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact>
              <ode>
                <kp>500000.0</kp>
                <kd>500.0</kd>
                <max_vel>0.005</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
