          <geometry><cylinder><radius>0.022</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>1.0 0.1 0.1 1</diffuse></material>
        </visual>

        <!-- 3-Tier Industrial Stack Light (Andon Tower) -->
        <!-- Mast Upright -->
        <visual name="light_mast">
          <pose>0 0 1.50 0 0 0</pose>
          <geometry><cylinder><radius>0.012</radius><length>0.20</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <!-- Green Tier: Normal Running -->
        <visual name="stack_green">
          <pose>0 0 1.63 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.2 1.0 0.3 1</diffuse><emissive>0.1 0.8 0.2 1</emissive></material>
        </visual>
        <!-- Amber Tier: Inspection / Alert -->
        <visual name="stack_amber">
          <pose>0 0 1.69 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>1.0 0.75 0.1 1</diffuse></material>
        </visual>
        <!-- Red Tier: Stop / Fault -->
        <visual name="stack_red">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         PERIMETER SAFETY GUARDING FENCE (Extruded Aluminum & Mesh)
         ═══════════════════════════════════════════════════════════ -->
    <model name="safety_perimeter_fence">
      <static>true</static>
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <link name="fence_link">
        <!-- Rear Guard Panel -->
        <collision name="rear_fence_col"><pose>-0.75 0.0 0.80 0 0 0</pose><geometry><box><size>0.04 1.80 1.60</size></box></geometry></collision>
        <visual name="rear_fence_frame"><pose>-0.75 0.0 0.80 0 0 0</pose><geometry><box><size>0.04 1.80 1.60</size></box></geometry><material><ambient>0.8 0.7 0.1 0.5</ambient><diffuse>0.9 0.8 0.1 0.6</diffuse></material></visual>

        <!-- Left Guard Panel -->
        <collision name="left_fence_col"><pose>0.0 0.95 0.80 0 0 0</pose><geometry><box><size>1.50 0.04 1.60</size></box></geometry></collision>
        <visual name="left_fence_frame"><pose>0.0 0.95 0.80 0 0 0</pose><geometry><box><size>1.50 0.04 1.60</size></box></geometry><material><ambient>0.8 0.7 0.1 0.5</ambient><diffuse>0.9 0.8 0.1 0.6</diffuse></material></visual>

        <!-- Right Guard Panel -->
        <collision name="right_fence_col"><pose>0.0 -0.95 0.80 0 0 0</pose><geometry><box><size>1.50 0.04 1.60</size></box></geometry></collision>
        <visual name="right_fence_frame"><pose>0.0 -0.95 0.80 0 0 0</pose><geometry><box><size>1.50 0.04 1.60</size></box></geometry><material><ambient>0.8 0.7 0.1 0.5</ambient><diffuse>0.9 0.8 0.1 0.6</diffuse></material></visual>

        <!-- Warning Sign Plate on Fence -->
        <visual name="warning_sign">
          <pose>-0.72 0.0 1.30 0 0 0</pose>
          <geometry><box><size>0.005 0.35 0.20</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1.0 0.9 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════
         INITIAL WORKPIECES ON THE CONVEYOR LINE
         ═══════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════
         INDUSTRIAL MANUFACTURING LINE: MULTI-PART INFEED STREAM
         Queued along the conveyor line from pick stopper to tail.
         ═══════════════════════════════════════════════════════════ -->

    <!-- Part 1: Good Component docked at the Pick Station Stopper -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_01</name>
      <pose>0.20 0.070 0.644 0 0 0</pose>
    </include>

    <!-- Part 2: Good Component in queue -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_02</name>
      <pose>0.20 0.160 0.644 0 0 0</pose>
    </include>

    <!-- Part 3: Good Component in queue -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_03</name>
      <pose>0.20 0.250 0.644 0 0 0</pose>
    </include>

    <!-- Part 4: Defective Component (Red with yellow defect cross) in queue -->
    <include>
      <uri>model://workpiece_defect</uri>
      <name>workpiece_04</name>
      <pose>0.20 0.340 0.644 0 0 0</pose>
    </include>

    <!-- Part 5: Good Component in queue -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_05</name>
      <pose>0.20 0.430 0.644 0 0 0</pose>
    </include>

    <!-- Part 6: Good Component in queue -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_06</name>
      <pose>0.20 0.520 0.644 0 0 0</pose>
    </include>

    <!-- Part 7: Defective Component in queue -->
    <include>
      <uri>model://workpiece_defect</uri>
      <name>workpiece_07</name>
      <pose>0.20 0.610 0.644 0 0 0</pose>
    </include>

    <!-- Part 8: Good Component entering at infeed tail -->
    <include>
      <uri>model://workpiece_good</uri>
      <name>workpiece_08</name>
      <pose>0.20 0.700 0.644 0 0 0</pose>
    </include>

  </world>
</sdf>
