    <!-- ═══════════════════════════════════════════════════════════
         INDUSTRIAL INFRASTRUCTURE: CONTROL CABINET & STACK LIGHT
         ═══════════════════════════════════════════════════════════ -->
    <model name="industrial_control_cabinet">
      <static>true</static>
      <pose>-0.55 0.70 0.0 0 0 -0.52</pose>
      <link name="cabinet_link">
        <!-- Main Enclosure (RAL 7035 Light Grey) -->
        <collision name="cabinet_col">
          <pose>0 0 0.70 0 0 0</pose>
          <geometry><box><size>0.40 0.30 1.40</size></box></geometry>
        </collision>
