          <pose>-0.055 0 0.045 0 0 0</pose>
          <geometry><box><size>0.010 0.14 0.080</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          </surface>
        </collision>
        <visual name="w_wall_vis"><pose>-0.055 0 0.045 0 0 0</pose><geometry><box><size>0.010 0.14 0.080</size></box></geometry><material><ambient>0.7 0.1 0.1 1</ambient></material></visual>
        <!-- Yellow "REJECT / SCRAP" Warning Strip on Bin Rim -->
        <visual name="reject_rim_stripe">
          <pose>0 0.065 0.085 0 0 0</pose>
          <geometry><box><size>0.11 0.008 0.002</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══ AUXILIARY COMPONENT SUPPLY BIN (Raw Parts Stock) ═══ -->
    <model name="supply_bin">
      <static>true</static>
      <pose>-0.06 0.22 0.608 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <pose>0 0 0.025 0 0 0</pose>
