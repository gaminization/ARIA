            <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          </surface>
        </collision>
        <visual name="n_wall_vis"><pose>0 0.065 0.045 0 0 0</pose><geometry><box><size>0.12 0.010 0.080</size></box></geometry><material><ambient>0.7 0.1 0.1 1</ambient></material></visual>
        <!-- South Wall -->
        <collision name="s_wall_col">
          <pose>0 -0.065 0.045 0 0 0</pose>
          <geometry><box><size>0.12 0.010 0.080</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          </surface>
        </collision>
        <visual name="s_wall_vis"><pose>0 -0.065 0.045 0 0 0</pose><geometry><box><size>0.12 0.010 0.080</size></box></geometry><material><ambient>0.7 0.1 0.1 1</ambient></material></visual>
        <!-- East Wall -->
        <collision name="e_wall_col">
          <pose>0.055 0 0.045 0 0 0</pose>
          <geometry><box><size>0.010 0.14 0.080</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000000.0</threshold></bounce>
          </surface>
        </collision>
        <visual name="e_wall_vis"><pose>0.055 0 0.045 0 0 0</pose><geometry><box><size>0.010 0.14 0.080</size></box></geometry><material><ambient>0.7 0.1 0.1 1</ambient></material></visual>
        <!-- West Wall -->
